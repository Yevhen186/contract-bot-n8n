      "typeVersion": 3,
      "position": [
        220,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "7tK2zBZfJopHGKcH",
          "name": "Google Drive account 2"
        }
      },
      "parameters": {
        "operation": "copy",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.templateId }}",
          "mode": "id"
        },
        "name": "={{ $json.fileName }}",
        "options": {}
      },
      "id": "8c4d5445-94dc-4b00-8f6f-7699700c1bf4"
    },
    {
      "name": "Convert to Google Doc",
