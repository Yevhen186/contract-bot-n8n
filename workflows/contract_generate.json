      "typeVersion": 4.4,
      "position": [
        440,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "7tK2zBZfJopHGKcH",
          "name": "Google Drive account 2"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $('Copy file').item.json.id }}/copy",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mimeType: 'application/vnd.google-apps.document', name: $('When Executed by Another Workflow').item.json.fileName }) }}",
        "options": {}
      },
      "id": "b9be7778-a620-4062-b542-e0c0197cac4e"
    },
