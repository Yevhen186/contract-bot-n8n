    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\n// Знаходимо рядок з найсвіжішим updated_at\nlet latest = null;\nfor (const row of rows) {\n  const t = row.json.updated_at;\n  if (!t) continue;\n  if (!latest || t > latest.json.updated_at) {\n    latest = row;\n  }\n}\n\nconst chat_id = latest?.json?.chat_id ? String(latest.json.chat_id).replace(/\\s/g, '') : null;\nconst error_message = $('Error Trigger').first().json.execution?.error?.message || 'Невідома помилка';\nconst error_node = $('Error Trigger').first().json.execution?.error?.node?.name || $('Error Trigger').first().json.execution?.lastNodeExecuted || 'Невідомий вузол';\n\nreturn [{\n  json: {\n    chat_id,\n    error_message,\n    error_node\n  }\n}];"
      },
