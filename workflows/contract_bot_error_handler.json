    {
      "parameters": {
        "jsCode": "const t = $('Error Trigger').first().json;\nconst rows = $input.all().map(r => r.json).filter(r => r.chat_id && r.updated_at);\n// чат менеджера, який діяв останнім (за updated_at у Sessions_v2) — і лише якщо це було в останні 15 хв\nlet latest = null;\nfor (const r of rows) if (!latest || String(r.updated_at) > String(latest.updated_at)) latest = r;\nconst fresh = latest && (Date.now() - new Date(latest.updated_at).getTime()) < 15 * 60e3;\nconst chat_id = latest && fresh ? String(latest.chat_id).replace(/s/g, '') : '';\nconst ex = t.execution || {};\nreturn [{ json: {\n  chat_id,\n  error_message: String(ex.error?.message || 'Невідома помилка').slice(0, 500),\n  error_node: ex.error?.node?.name || ex.lastNodeExecuted || 'Невідомий вузол',\n  workflow: t.workflow?.name || '',\n  url: ex.url || '',\n} }];"
      },
      "type": "n8n-nodes-base.code",
