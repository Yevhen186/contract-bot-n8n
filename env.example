# =============================================================================
# CONTRACT BOT — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# TELEGRAM
# -----------------------------------------------------------------------------

# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here


# -----------------------------------------------------------------------------
# OPENAI
# -----------------------------------------------------------------------------

# Used for: GPT-4.1-mini (contract parsing), Whisper (voice), GPT-4o (vision/PDF)
OPENAI_API_KEY=sk-...


# -----------------------------------------------------------------------------
# GOOGLE OAUTH2
# -----------------------------------------------------------------------------
# One OAuth2 client covers all Google services (Sheets, Drive, Docs).
# Create at: https://console.cloud.google.com → APIs & Services → Credentials

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://your-n8n-instance.railway.app/rest/oauth2-credential/callback

# Important: set Publishing status to "In production" in OAuth consent screen.
# Otherwise tokens expire every 7 days.


# -----------------------------------------------------------------------------
# GOOGLE SHEETS — Sessions
# -----------------------------------------------------------------------------

# The spreadsheet used to track conversation sessions
SESSIONS_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet name (default: Sessions)
SESSIONS_SHEET_NAME=Sessions


# -----------------------------------------------------------------------------
# GOOGLE DRIVE — Contract Templates
# -----------------------------------------------------------------------------
# File IDs of the 4 .docx contract templates in your Google Drive

TEMPLATE_AUTOMOV_CLIENT=your_drive_file_id      # АвтоМув — client side (З)
TEMPLATE_AUTOMOV_CARRIER=your_drive_file_id     # АвтоМув — carrier side (П)
TEMPLATE_UTS_CLIENT=your_drive_file_id          # ЮТС — client side (З)
TEMPLATE_UTS_CARRIER=your_drive_file_id         # ЮТС — carrier side (П)

# Folder ID where temporary copies are created during generation
DRIVE_TEMP_FOLDER_ID=your_temp_folder_id


# -----------------------------------------------------------------------------
# N8N (if self-hosting)
# -----------------------------------------------------------------------------

N8N_HOST=your-n8n-instance.railway.app
N8N_PORT=5678
N8N_PROTOCOL=https

# Webhook URL base (used by Telegram trigger)
WEBHOOK_URL=https://your-n8n-instance.railway.app/
